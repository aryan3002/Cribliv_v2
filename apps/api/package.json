{
  "name": "@cribliv/api",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "worker": "ts-node src/worker/worker.ts",
    "lint": "echo 'api lint placeholder'",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node ../../infra/migrations/run-migrations.js",
    "db:seed": "ts-node --files --transpile-only --compiler-options '{\"module\":\"CommonJS\",\"moduleResolution\":\"Node\",\"target\":\"ES2020\",\"esModuleInterop\":true}' ../../data/seeds/seed.ts",
    "seed:reference": "SEED_REFERENCE_ONLY=1 ts-node --files --transpile-only --compiler-options '{\"module\":\"CommonJS\",\"moduleResolution\":\"Node\",\"target\":\"ES2020\",\"esModuleInterop\":true}' ../../data/seeds/seed.ts",
    "generate:city": "ts-node --files --transpile-only --compiler-options '{\"module\":\"CommonJS\",\"moduleResolution\":\"Node\",\"target\":\"ES2020\",\"esModuleInterop\":true}' ../../data/seeds/generate-city.ts",
    "load:city": "ts-node --files --transpile-only --compiler-options '{\"module\":\"CommonJS\",\"moduleResolution\":\"Node\",\"target\":\"ES2020\",\"esModuleInterop\":true}' ../../data/seeds/load-city.ts",
    "migrate:v1": "ts-node --files --transpile-only --compiler-options '{\"module\":\"CommonJS\",\"moduleResolution\":\"Node\",\"target\":\"ES2020\",\"esModuleInterop\":true}' src/migration/v1/migrate.ts"
  },
  "dependencies": {
    "@azure/storage-blob": "^12.31.0",
    "@nestjs/common": "^10.4.2",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.2",
    "@nestjs/platform-express": "^10.4.2",
    "@nestjs/platform-socket.io": "10.4.2",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "10.4.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.5",
    "handlebars": "^4.7.9",
    "helmet": "^8.1.0",
    "microsoft-cognitiveservices-speech-sdk": "^1.48.0",
    "mongodb": "^6.12.0",
    "multer": "^2.1.1",
    "otplib": "^12.0.1",
    "pg": "^8.13.0",
    "puppeteer": "^25.0.4",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.3",
    "uuid": "^10.0.0",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.1.4",
    "@nestjs/testing": "^10.4.2",
    "@types/express": "^5.0.0",
    "@types/handlebars": "^4.1.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.7.4",
    "@types/pg": "^8.11.10",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.3",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8",
    "zod-to-json-schema": "^3.25.2"
  }
}
