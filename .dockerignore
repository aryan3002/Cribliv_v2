# Git history
.git

# Node modules — Docker installs its own
**/node_modules

# Build artefacts — Docker rebuilds these
**/dist
**/.next
**/*.tsbuildinfo

# Secrets — never bake into the image
.env
.env.*
!.env.example

# Web app + all packages stay in the context: Dockerfile (API) copies only
# apps/api + shared-types, while Dockerfile.web needs apps/web + packages/*.
# Web test/tooling output that neither image needs:
apps/web/test-results
apps/web/playwright-report
apps/web/tests

# Infra scripts — not part of the runtime image
infra/

# Tooling and caches
.turbo
.github
.husky
.vscode
*.local
