NODE_ENV=development
WEB_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/v1
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/cribliv_v2
JWT_ACCESS_SECRET=replace-me
JWT_REFRESH_SECRET=replace-me
OTP_PROVIDER=mock
OTP_API_KEY=replace-me
OTP_SENDER_ID=CRIBLV
D7_KEY=
D7_BASE_URL=https://api.d7networks.com
D7_OTP_CONTENT_TEMPLATE=Greetings from CribLiv, your mobile verification code is: {}
D7_OTP_EXPIRY_SEC=300
BLOB_ACCOUNT_NAME=replace-me
BLOB_ACCOUNT_KEY=replace-me
BLOB_CONTAINER_LISTING_MEDIA=listing-media
BLOB_CONTAINER_VERIFICATION=verification-artifacts
AI_ROUTER_PROVIDER=mock
AI_ROUTER_API_KEY=replace-me
AI_ROUTER_TIMEOUT_MS=1200
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_EXTRACT_DEPLOYMENT=
AZURE_AI_TIMEOUT_MS=8000
RATE_LIMIT_REDIS_URL=
PAYMENT_PROVIDER_KEY=replace-me
PAYMENT_WEBHOOK_SECRET=replace-me
RAZORPAY_WEBHOOK_SECRET=
UPI_WEBHOOK_SECRET=
# Wallet credit-purchase Razorpay Orders client (Slice 3). mock never calls
# out to Razorpay; live requires RAZORPAY_KEY_ID/SECRET (fails closed without them).
RAZORPAY_ORDERS_MODE=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_API_TIMEOUT_MS=8000
FF_REAL_VERIFICATION_PROVIDER=false
FF_PG_SALES_LEADS=true
FF_OWNER_LISTING_ASSISTED_CAPTURE=
FF_PRODUCTION_DB_ONLY=true
# Slice 2 - Indexing + Measurement (default OFF; flip at v1->v2 cutover)
FF_SEO_INDEXING=false
FF_SEO_GSC=false
GSC_SITE_URL=sc-domain:cribliv.com
GSC_SERVICE_ACCOUNT_JSON=
GOOGLE_INDEXING_DAILY_QUOTA=200
# Canonical origin used to build absolute URLs submitted to the Indexing API.
SEO_SITE_BASE_URL=https://cribliv.com
CRM_WEBHOOK_URL=
VERIFICATION_PROVIDER_TIMEOUT_MS=5000
LIVENESS_PROVIDER_URL=
LIVENESS_PROVIDER_API_KEY=
LIVENESS_PROVIDER_NAME=mock_liveness_v1
ELECTRICITY_PROVIDER_URL=
ELECTRICITY_PROVIDER_API_KEY=
ELECTRICITY_PROVIDER_NAME=mock_bbps_v1
## ——— Voice Agent (legacy STT+LLM+TTS pipeline) ———
FF_VOICE_AGENT_ENABLED=false
VOICE_AGENT_TTS_VOICE=hi-IN-SwaraNeural
VOICE_AGENT_SESSION_TIMEOUT_MS=900000
VOICE_AGENT_MAX_TURNS=50
AZURE_OPENAI_CONVERSATION_DEPLOYMENT=

## ——— Realtime Concierge "Maya" (Azure OpenAI Realtime + WebRTC) ———
# Toggle the new free-form, mixed-initiative voice concierge. Default ON in dev,
# gated rollout in prod. Browser also reads NEXT_PUBLIC_FF_VOICE_REALTIME.
FF_VOICE_AGENT_REALTIME=true
# Optional override for a dedicated realtime resource. Use this when your
# chat/extract deployments live on one Azure OpenAI resource, but realtime
# lives on another (recommended for CribLiv).
AZURE_OPENAI_REALTIME_ENDPOINT=
# Optional but recommended when realtime uses a different Azure OpenAI
# resource than chat/extract. Falls back to AZURE_OPENAI_API_KEY if omitted.
AZURE_OPENAI_REALTIME_API_KEY=
# Required: the ACTUAL deployment name you created for your realtime model.
# Example current choices:
#   gpt-realtime-mini  (cheap; best for dev/staging)
#   gpt-realtime       (higher quality; best for prod)
AZURE_OPENAI_REALTIME_DEPLOYMENT=gpt-realtime-mini
# Voice. One of alloy, ash, ballad, coral, echo, sage, shimmer, verse, marin.
# `sage` is warm and India-friendly; `coral` is brighter / more upbeat.
AZURE_OPENAI_REALTIME_VOICE=sage
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

## ——— WhatsApp Notifications (Meta Cloud API / WABA) ———
FF_WHATSAPP_NOTIFICATIONS=true
WHATSAPP_PROVIDER=mock
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_TOKEN=
WHATSAPP_API_URL=

## ——— Rent Agreement v2 (backend) ———
# Feature gates. Both default OFF. Enabling the user-facing flag requires
# RENT_AGREEMENT_PAN_KEY and RENT_AGREEMENT_IP_SALT to be set (fail-fast at boot).
FF_RENT_AGREEMENT_ENABLED=false
FF_RENT_AGREEMENT_ADMIN_ENABLED=false

# AES-256-GCM key for PAN ciphertext columns. Generate: `openssl rand -base64 32`.
RENT_AGREEMENT_PAN_KEY=
# SHA-256 salt for hashing download-audit IP addresses. Generate: `openssl rand -base64 32`.
RENT_AGREEMENT_IP_SALT=

# Azure Blob container holding generated PDFs. SAS URLs are minted per download.
RENT_AGREEMENT_AZURE_CONTAINER=rent-agreements

# PDF worker tuning.
RENT_AGREEMENT_PDF_WORKER_CONCURRENCY=3
RENT_AGREEMENT_PDF_MAX_PAGES_PER_BROWSER=50
RENT_AGREEMENT_PDF_BROWSER_MEM_LIMIT_MB=600
RENT_AGREEMENT_PDF_MAX_ATTEMPTS=5

# Business rules.
RENT_AGREEMENT_DOWNLOAD_SAS_TTL_SECONDS=3600
RENT_AGREEMENT_MAX_DOWNLOADS_PER_AGREEMENT=5
RENT_AGREEMENT_AGREEMENT_EXPIRY_DAYS=7
