# ─── Cribliv web (Next.js) image for Azure Container Apps ────────────────────
# Build from the monorepo root:
#   az acr build -r criblivprodacr -t cribliv-web:<tag> -f Dockerfile.web \
#     --build-arg NEXT_PUBLIC_API_BASE_URL=... .
# NEXT_PUBLIC_* values are inlined into the client bundle at BUILD time, so they
# are build args, not runtime env. Server-only secrets (AUTH_SECRET, etc.) are
# runtime env on the container app and must never be passed here.

# ─── Stage 1: Build ──────────────────────────────────────────────────────────
FROM node:20-alpine AS builder

RUN apk add --no-cache libc6-compat && corepack enable

WORKDIR /app

COPY pnpm-workspace.yaml pnpm-lock.yaml package.json turbo.json tsconfig.base.json ./
COPY apps/api/package.json         ./apps/api/
COPY apps/web/package.json         ./apps/web/
COPY packages/shared-types/package.json ./packages/shared-types/
COPY packages/config/package.json  ./packages/config/
COPY packages/ui/package.json      ./packages/ui/

RUN pnpm install --frozen-lockfile

COPY packages ./packages
# lib/intent-filters.ts, lib/map-search-index.ts, lib/nav/localities.ts import
# JSON from the repo-root data/seeds (inlined by webpack at build time).
COPY data ./data
COPY apps/web ./apps/web

ARG NEXT_PUBLIC_API_BASE_URL
ARG NEXT_PUBLIC_SITE_URL
ARG NEXT_PUBLIC_PHOTO_BASE_URL
ARG NEXT_PUBLIC_GOOGLE_MAPS_API_KEY
ARG NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID
ARG NEXT_PUBLIC_POSTHOG_KEY
ARG NEXT_PUBLIC_POSTHOG_HOST
ARG NEXT_PUBLIC_CLARITY_ID
ARG NEXT_PUBLIC_RAZORPAY_KEY_ID
ARG NEXT_PUBLIC_FF_ADMIN_TOTP
ARG NEXT_PUBLIC_FF_CALLBACK_LEADS
ARG NEXT_PUBLIC_FF_CREDIT_PURCHASE_ENABLED
ARG NEXT_PUBLIC_FF_GUEST_GATING
ARG NEXT_PUBLIC_FF_LEAD_MANAGEMENT_ENABLED
ARG NEXT_PUBLIC_FF_LISTENING_HERO
ARG NEXT_PUBLIC_FF_LISTING_ANALYTICS_ENABLED
ARG NEXT_PUBLIC_FF_PG_MAINTENANCE_OPS_V2
ARG NEXT_PUBLIC_FF_PG_VOICE_LISTING
ARG NEXT_PUBLIC_FF_UNAVAILABLE_LISTINGS
ARG NEXT_PUBLIC_FF_VOICE_AGENT_ENABLED
ARG NEXT_PUBLIC_FF_VOICE_REALTIME
ARG NEXT_PUBLIC_RENT_AGREEMENT_DEV_AUTH
ARG NEXT_PUBLIC_RENT_AGREEMENT_USE_MOCK_PROVIDERS
# Server-side, but read by next.config.mjs at build time (CSP connect-src).
ARG AZURE_STORAGE_ACCOUNT_NAME
ARG PHOTO_PUBLIC_BASE_URL

ENV NEXT_TELEMETRY_DISABLED=1

RUN pnpm turbo build --filter=@cribliv/web

# ─── Stage 2: Runtime ────────────────────────────────────────────────────────
FROM node:20-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0

RUN addgroup -S nodejs && adduser -S nextjs -G nodejs

# standalone mirrors the monorepo layout from outputFileTracingRoot, so the
# server entry lives at apps/web/server.js. static/ and public/ are not traced
# and must be copied in explicitly.
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/public ./apps/web/public
# Read at runtime via readFileSync(process.cwd()/content/...) in
# lib/agent-skills.ts + lib/markdown-for-agents.ts — dynamic paths aren't traced.
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/content ./apps/web/content

USER nextjs

EXPOSE 3000

CMD ["node", "apps/web/server.js"]
